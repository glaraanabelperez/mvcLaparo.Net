{
  "AllowedHosts": "*",
  "ConnectionStrings": {

    "DefaultConnection": "Server=localhost;Port=3306;Database=importsurgery;User=root;Password=;"
  },
  "Services": {
    "ProductsApi": "https://localhost:5001/"
  },
  "Paths": {
    "imagesPath": "C:\\Uploads\\images\\products",
    "tempPath": "C:\\Uploads\\images\\products-temp"
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SecretsKeys": {
    "SecretKeyLog": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/apilog_",
          "rollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} {Message:lj}{NewLine} {Exception}"
        }
      }
    ]
  }
}
