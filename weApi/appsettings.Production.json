{
  "AllowedHosts": "*",
  "connectionstrings": {
    "defaultconnection": "server=localhost;port=3306;database=importsurgery;user=importsurgery;password=importsurgery1234;"
  },
  "Services": {
    "ProductsApi": "https://importsurgery.com/"
  },
  "Paths": {
    "imagesPath": "Uploads\\images\\products",
    "tempPath": "Uploads\\images\\products-temp"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "SecretsKeys": {
    "SecretKeyLog": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.File" ],
    //"MinimunLevel": {
    //  "Default": "Warning",
    //  "Overrite": {
    //    "Microsoft": "Warning",
    //    "System": "Warning"
    //  }
    //},
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "./logs/apilog_",
          "rollingInterval": "Day",
          "OutputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {CorrelationId} {Level:u3}] {Username} {Message:lj}{NewLine} {Exception}"
        }
      }
    ]
  }
}
