@{
    ViewData["Title"] = "Login";
    var returnUrl = ViewData["ReturnUrl"] as string;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-sm-10 col-md-8 col-lg-5">
            <div class="card shadow-sm rounded-4">
                <div class="card-body p-4">
                    <div class="text-center mb-3">
                        <h3 class="mb-1">Iniciar sesión</h3>
                        <p class="text-muted small mb-0">Accede para administrar las subidas y contenidos protegidos</p>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="alert alert-danger" role="alert">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    }

                    <form asp-action="Login" method="post" novalidate>
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@returnUrl" />

                        <div class="form-floating mb-3">
                            <input type="text" class="form-control" id="username" name="username" placeholder="Usuario" required aria-label="Usuario" />
                            <label for="username">Usuario</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" class="form-control" id="password" name="password" placeholder="Contraseña" required aria-label="Contraseña" />
                            <label for="password">Contraseña</label>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg">Entrar</button>
                        </div>

                        <div class="text-center">
                            <a asp-controller="Home" asp-action="Index" class="link-secondary small">Volver al inicio</a>
                        </div>
                    </form>
                </div>
            </div>

            <div class="text-center mt-3 small text-muted">
                Este acceso es sólo para personal autorizado.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // UX mínimo: focusear el campo usuario
        (function () {
            const u = document.getElementById('username');
            if (u) u.focus();
        })();
    </script>
}